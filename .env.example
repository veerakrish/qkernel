# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit your actual token.
# Leave QKERNEL_IBM_TOKEN unset to use a locally saved account instead
# (QiskitRuntimeService.save_account()) - that's the default and doesn't
# need this file at all.

QKERNEL_BACKEND=ibm
QKERNEL_IBM_TOKEN=your_ibm_api_key_here
QKERNEL_IBM_CHANNEL=ibm_quantum_platform
